rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return (
          isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
        || request.auth.uid in ['GYA5hIMrHpScR4cHScQ3wNw59v93'];
    }

    function postDoc(postId) {
      return get(/databases/$(database)/documents/posts/$(postId));
    }

    function commentDoc(commentId) {
      return get(/databases/$(database)/documents/comments/$(commentId));
    }

    function hasBlockedTerm(value) {
      return value.matches('.*(死ね|殺す|レイプ|暴行|児童ポルノ|自殺しろ|porn|Porn|PORN|nude|Nude|NUDE|sex|Sex|SEX|gore|Gore|GORE|violent|Violent|VIOLENT).*');
    }

    function isCleanOptionalString(value) {
      return value == null || (value is string && !hasBlockedTerm(value));
    }

    function isCleanPostBody() {
      return request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && !hasBlockedTerm(request.resource.data.body)
        && isCleanOptionalString(request.resource.data.imageUrl);
    }

    function isCleanPostTitle() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && !hasBlockedTerm(request.resource.data.title);
    }

    function isCleanCommentBody() {
      return request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && !hasBlockedTerm(request.resource.data.body)
        && isCleanOptionalString(request.resource.data.imageUrl);
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    function isOptionalNonNegativeInt(value) {
      return value == null || (value is int && value >= 0);
    }

    function isOptionalStringMax(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function isValidCommentSchema() {
      return request.resource.data.keys().hasOnly([
        'postId',
        'authorUid',
        'authorUserId',
        'authorDisplayName',
        'authorPhotoUrl',
        'body',
        'imageUrl',
        'replyToCommentId',
        'replyToAuthorUid',
        'replyToAuthorName',
        'isBestAnswer',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidCommentCreateData() {
      return isValidCommentSchema()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.authorDisplayName is string
        && isOptionalStringMax(request.resource.data.authorUserId, 80)
        && isOptionalStringMax(request.resource.data.authorPhotoUrl, 500)
        && isOptionalStringMax(request.resource.data.replyToCommentId, 120)
        && isOptionalStringMax(request.resource.data.replyToAuthorUid, 120)
        && isOptionalStringMax(request.resource.data.replyToAuthorName, 60)
        && isCleanCommentBody()
        && request.resource.data.isBestAnswer == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isCommentAuthorContentUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'body',
          'imageUrl',
          'updatedAt'
        ])
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.isBestAnswer == resource.data.isBestAnswer
        && isCleanCommentBody()
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidNotificationSchema() {
      return request.resource.data.keys().hasOnly([
        'userUid',
        'actorUid',
        'actorDisplayName',
        'actorPhotoUrl',
        'type',
        'postId',
        'commentId',
        'parentCommentId',
        'bodySnippet',
        'isRead',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isBestAnswerNotificationCreate() {
      return request.resource.data.type == 'best_answer'
        && request.resource.data.commentId is string
        && commentDoc(request.resource.data.commentId).data.postId == request.resource.data.postId
        && postDoc(request.resource.data.postId).data.authorUid == request.auth.uid
        && commentDoc(request.resource.data.commentId).data.authorUid == request.resource.data.userUid;
    }

    function isFeedbackNotificationCreate() {
      return request.resource.data.type == 'feedback'
        && request.resource.data.commentId is string
        && commentDoc(request.resource.data.commentId).data.postId == request.resource.data.postId
        && commentDoc(request.resource.data.commentId).data.authorUid == request.auth.uid
        && postDoc(request.resource.data.postId).data.authorUid == request.resource.data.userUid;
    }

    function isReplyNotificationCreate() {
      return request.resource.data.type == 'reply'
        && request.resource.data.commentId is string
        && request.resource.data.parentCommentId is string
        && commentDoc(request.resource.data.commentId).data.postId == request.resource.data.postId
        && commentDoc(request.resource.data.parentCommentId).data.postId == request.resource.data.postId
        && commentDoc(request.resource.data.commentId).data.authorUid == request.auth.uid
        && commentDoc(request.resource.data.parentCommentId).data.authorUid == request.resource.data.userUid;
    }

    function isValidNotificationCreateData() {
      return isValidNotificationSchema()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.userUid is string
        && request.resource.data.userUid != request.auth.uid
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && isOptionalStringMax(request.resource.data.commentId, 120)
        && isOptionalStringMax(request.resource.data.parentCommentId, 120)
        && request.resource.data.actorDisplayName is string
        && isOptionalStringMax(request.resource.data.actorPhotoUrl, 500)
        && isOptionalStringMax(request.resource.data.bodySnippet, 80)
        && request.resource.data.isRead == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          isBestAnswerNotificationCreate()
          || isFeedbackNotificationCreate()
          || isReplyNotificationCreate()
        );
    }

    function isValidPostSchema() {
      return request.resource.data.keys().hasOnly([
        'authorUid',
        'authorDisplayName',
        'authorPhotoUrl',
        'title',
        'body',
        'worryGenre',
        'musicGenre',
        'daw',
        'imageUrl',
        'audioUrl',
        'audioDurationSec',
        'focusSecondSec',
        'allowExternalFeature',
        'updatedAt',
        'isSolved',
        'bestAnswerCommentId',
        'deleted',
        'questionType',
        'isPriority',
        'likeCount',
        'createdAt'
      ]);
    }

    function isValidPostCreateData() {
      return isValidPostSchema()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorDisplayName is string
        && isOptionalString(request.resource.data.authorPhotoUrl)
        && isCleanPostTitle()
        && isCleanPostBody()
        && isOptionalString(request.resource.data.worryGenre)
        && isOptionalString(request.resource.data.musicGenre)
        && isOptionalString(request.resource.data.daw)
        && isOptionalString(request.resource.data.audioUrl)
        && isOptionalNonNegativeInt(request.resource.data.audioDurationSec)
        && isOptionalNonNegativeInt(request.resource.data.focusSecondSec)
        && request.resource.data.allowExternalFeature is bool
        && request.resource.data.isSolved == false
        && request.resource.data.bestAnswerCommentId == null
        && request.resource.data.deleted == false
        && request.resource.data.questionType == 'open'
        && request.resource.data.isPriority == false
        && request.resource.data.likeCount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isPostOwnerContentUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'title',
          'body',
          'worryGenre',
          'musicGenre',
          'daw',
          'imageUrl',
          'audioUrl',
          'audioDurationSec',
          'focusSecondSec',
          'allowExternalFeature',
          'updatedAt'
        ])
        && isCleanPostTitle()
        && isCleanPostBody()
        && isOptionalString(request.resource.data.worryGenre)
        && isOptionalString(request.resource.data.musicGenre)
        && isOptionalString(request.resource.data.daw)
        && isOptionalString(request.resource.data.audioUrl)
        && isOptionalNonNegativeInt(request.resource.data.audioDurationSec)
        && isOptionalNonNegativeInt(request.resource.data.focusSecondSec)
        && request.resource.data.allowExternalFeature is bool
        && request.resource.data.updatedAt is timestamp;
    }

    function isPostAuthorProfileSyncUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'authorDisplayName',
          'authorPhotoUrl'
        ])
        && request.resource.data.authorDisplayName is string
        && isOptionalString(request.resource.data.authorPhotoUrl);
    }

    function isPostSolvedStatusUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'isSolved',
          'bestAnswerCommentId',
          'updatedAt'
        ])
        && request.resource.data.isSolved == true
        && request.resource.data.bestAnswerCommentId is string
        && request.resource.data.updatedAt is timestamp;
    }

    // users: 公開プロフィールは読み取り可。作成/更新は本人のみ。
    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'userId',
          'displayName',
          'bio',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.userId is string
        && request.resource.data.displayName is string
        && isOptionalString(request.resource.data.bio)
        && isOptionalString(request.resource.data.photoUrl)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName',
          'bio',
          'photoUrl',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // posts: 読み取り公開。作成/更新/削除は投稿者本人のみ。
    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidPostCreateData();

      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && isValidPostSchema()
        && (
          isPostOwnerContentUpdate()
          || isPostAuthorProfileSyncUpdate()
          || isPostSolvedStatusUpdate()
        );

      allow delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;
    }

    // comments: 読み取り公開。
    // 作成は本人のみ。更新はコメント作成者、または投稿者が isBestAnswer を付ける場合のみ。
    // 削除はコメント作成者または投稿者。
    match /comments/{commentId} {
      allow read: if true;

      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && isValidCommentCreateData();

      allow update: if isSignedIn() && (
        // コメント作成者の通常更新
        (resource.data.authorUid == request.auth.uid
          && isValidCommentSchema()
          && isCommentAuthorContentUpdate())
        ||
        // 投稿者がベストアンサー指定
        (
          postDoc(resource.data.postId).data.authorUid == request.auth.uid
          && resource.data.authorUid != request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isBestAnswer', 'updatedAt'])
          && request.resource.data.isBestAnswer == true
        )
      );

      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid
        || postDoc(resource.data.postId).data.authorUid == request.auth.uid
      );
    }

    // notifications: 受信者本人のみ読み取り可。
    // 作成は送信者本人が行い、既読更新は受信者本人のみ。
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userUid == request.auth.uid;

      allow create: if isSignedIn()
        && isValidNotificationCreateData();

      allow update: if isSignedIn()
        && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.actorUid == resource.data.actorUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead', 'updatedAt']);

      allow delete: if false;
    }

    // rankingBestAnswers: 読み取り公開。クライアント書き込みは禁止。
    match /rankingBestAnswers/{uid} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // analytics_page_views_daily: 閲覧数の日別集計。
    match /analytics_page_views_daily/{dateKey} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }

    // analytics_summary: 閲覧数の累計集計。
    match /analytics_summary/{docId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }

    // x_post_drafts: X投稿用の下書き。管理者のみ閲覧・更新可。
    match /x_post_drafts/{draftId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
